[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
setup = "pipenv install --dev"
dev = "python3 main.py"
start = "gunicorn --bind localhost:50000 --timeout 1200 main:app"
tests = "python3 -m pytest"
coverage = "python3 -m pytest --cov --cov-report=term"
lint = "ruff check ."
format = "ruff format ."

# Keep in sync with requirements.txt / requirements-dev.txt.
[packages]
flask = "==3.1.3"
flask-restx = "==1.3.2"
gunicorn = "==26.2.0"
netcdf4 = "==1.7.4"
numpy = "==2.5.3"
simplejson = "==4.2.0"

[dev-packages]
pytest = "==9.1.1"
pytest-cov = "==7.1.0"
ruff = "==0.16.10"

[requires]
python_version = "3.13"
