### Config ###
STAGE=development
DISABLE_SWAGGER_AUTH=false

# Firebase project used by the public API to verify ID tokens
FIREBASE_PROJECT_ID=<your-firebase-project-id>

# Public API limits (comma-separated origins, "*" = all)
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=512

### Ports and hosts ###

# Frontend
ANGULAR_FRONTEND_PORT=8080

# Backend - Express Backend (public-api)
EXPRESS_BACKEND_HOST=express-backend
EXPRESS_BACKEND_PORT=40000

# Backend - Python Microservice (data-science)
PYTHON_BACKEND_HOST=python-backend
PYTHON_BACKEND_PORT=50000

# MongoDB
MONGODB_PORT=27017

# Only used in development
MONGODB_URL=mongodb://mongodb:${MONGODB_PORT}/datastore

# Only used in production
PROD_MONGODB_USERNAME=<your-username>
PROD_MONGODB_PASSWORD=<your-password>
PROD_MONGODB_URL=mongodb://<user>:<password>@<host>:27017/datastore?authSource=admin
